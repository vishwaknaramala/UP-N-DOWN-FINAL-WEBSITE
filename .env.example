# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend.com API key for transactional emails (e.g. re_xxxxxxxxx)
RESEND_API_KEY="re_your_resend_api_key_here"

# RESEND_FROM_EMAIL: The verified sender email in your Resend account (e.g. upndownstore.in)
RESEND_FROM_EMAIL="club@upndownstore.in"

# OWNER_NOTIFICATION_EMAIL: Store owner email to receive real-time customer registration alerts
OWNER_NOTIFICATION_EMAIL="vishwaknaramala@gmail.com"

# SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase Anon / Publishable API Key
SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"
